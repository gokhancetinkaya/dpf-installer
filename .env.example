# Copy to .env and edit. .env is gitignored.
# Use KEY=value with no inline comments. Quotes are optional.
# Paths may be absolute, or relative to this directory.

KUBECONFIG=
OPENSHIFT_PULL_SECRET=
SSH_KEY=

CLUSTER_NAME=
BASE_DOMAIN=
# HOST_CLUSTER_API is derived as api.${CLUSTER_NAME}.${BASE_DOMAIN} when unset.

# Deployment mode.
# host-trusted (default): the physical server joins as an OpenShift node via
#   BareMetalHost, and DPF configures the embedded DPU through that host.
# zero-trust: DPF never trusts the host OS. It provisions each DPU directly
#   over the DPU's own BMC/Redfish. See the "Zero Trust mode" section in
#   README.md before setting this to zero-trust.
DPF_DEPLOYMENT_MODE=host-trusted

# DPU networking. NODES_MTU must be 9000 or 1500; it selects the DPUFlavor.
# OVN_MTU is the overlay MTU, typically 100 less than NODES_MTU.
# Ignored in Zero Trust mode (v1 Zero Trust is HBN-only; it never deploys the
# OVN-Kubernetes DPU service): VTEP_CIDR, DPU_HOST_CIDR, OVN_MTU,
# OVN_POD_NETWORK, OVN_SERVICE_NETWORK.
VTEP_CIDR=10.0.120.0/22
DPU_HOST_CIDR=10.0.110.0/24
FLANNEL_POD_CIDR=10.132.0.0/14
NODES_MTU=9000
OVN_MTU=8900
NUM_VFS=46
TARGETCLUSTER_API_SERVER_PORT=6443
OVN_POD_NETWORK=10.128.0.0/14/23
OVN_SERVICE_NETWORK=172.30.0.0/16

# BlueField bootstream. Versions must match the image at BFB_URL.
BFB_URL=https://rhcos.mirror.openshift.com/art/storage/prod/streams/rhel-10.2/builds/10.2.20260715-0/aarch64/rhcos-10.2.20260715-0-nvidiabluefield.aarch64.bfb
BFB_ATF=4.15.0-4-g419fbf393
BFB_BSP=4.15.0.13998
BFB_DOCA=3.4.1
BFB_UEFI=4.15.0-19-g37c6f5adb2

# Charts and operators
DPU_WORKER_CONFIG_CHART=oci://registry.redhat.io/dpu-kit-for-nvidia/dpu-worker-config-chart
DPU_WORKER_CONFIG_VERSION=4.22.0
MAINTENANCE_OPERATOR_CHART=oci://ghcr.io/mellanox/maintenance-operator-chart
MAINTENANCE_OPERATOR_VERSION=0.3.0
DPF_HELM_REPO=https://helm.ngc.nvidia.com/nvidia/doca
DPF_VERSION=v26.4.1
# OVN_TEMPLATE_CHART_URL/OVN_CHART_VERSION are ignored in Zero Trust mode:
# they only back the VF resource injector (`make injector`), which refuses
# to run in Zero Trust.
OVN_TEMPLATE_CHART_URL=oci://ghcr.io/mellanox/charts
OVN_CHART_VERSION=v26.4.1-ocp-release-v4.22
DPF_HCP_PROVISIONER_CHART=oci://registry.redhat.io/dpu-kit-for-nvidia/dpf-hcp-provisioner-chart
DPF_HCP_PROVISIONER_VERSION=4.22.0
# Optional. Set both to run a main build instead of the chart's v4.22 image.
# The image name stays dpf-hcp-provisioner-rhel10-operator; the tag is latest.
# DPF_HCP_PROVISIONER_IMAGE_REPO=quay.io/redhat-user-workloads/dpu-kit-for-nvidia-operator-tenant/dpf-hcp-provisioner-rhel10-operator
# DPF_HCP_PROVISIONER_IMAGE_TAG=latest
GRAFANA_OPERATOR_CHART=oci://ghcr.io/grafana/helm-charts/grafana-operator
GRAFANA_OPERATOR_VERSION=5.24.0
GITOPS_OPERATOR_CHANNEL=gitops-1.21
GITOPS_OPERATOR_CSV=openshift-gitops-operator.v1.21.3

# Hosted cluster
HOSTED_CLUSTER_NAME=dpf-hosted
OPENSHIFT_VERSION=4.22.7
# OCP_RELEASE_IMAGE is derived from OPENSHIFT_VERSION when unset.
CLUSTERS_NAMESPACE=clusters
ETCD_STORAGE_CLASS=lvms-vg1
HOSTED_CLUSTER_VIP=
PULL_SECRET_NAME=pull-secret
SSH_KEY_SECRET_NAME=ssh-key

# Server chassis that the DPU is plugged into. Set WORKER_COUNT=0 to skip
# BareMetalHost provisioning in host-trusted mode.
# Zero Trust still uses WORKER_COUNT and the BMC address, user, and password
# to power this chassis on. It does not create a BareMetalHost, and it does
# not use BOOT_MAC or ROOT_DEVICE.
WORKER_COUNT=1
WORKER_NAME=worker-01
BMC_IP=
BMC_USER=
BMC_PASSWORD=
BOOT_MAC=
ROOT_DEVICE=

# Additional workers when WORKER_COUNT is greater than 1:
# WORKER_2_NAME=worker-02
# WORKER_2_BMC_IP=
# WORKER_2_BMC_USER=
# WORKER_2_BMC_PASSWORD=
# WORKER_2_BOOT_MAC=
# WORKER_2_ROOT_DEVICE=

# Zero Trust mode (used only when DPF_DEPLOYMENT_MODE=zero-trust).
# Every DPU BMC must already share this root password.
ZT_DPU_BMC_ROOT_PASSWORD=HelloNvidia3D!
# scanning (default): DPF scans the IP range below and discovers DPUs itself.
# static: pair every DPU serial with its own BMC IP below.
ZT_DPU_DISCOVERY_MODE=static
# Scanning mode only: ZT_DPU_DISCOVERY_NAME, ZT_DPU_BMC_IP_RANGE_START, and
# ZT_DPU_BMC_IP_RANGE_END.
ZT_DPU_DISCOVERY_NAME=dpu-discovery
ZT_DPU_BMC_IP_RANGE_START=
ZT_DPU_BMC_IP_RANGE_END=
# Fixed NodePort for the BFB registry Service this installer creates.
# The DPU BMC downloads the BFB from HOST_CLUSTER_API on this port. It must
# stay in the cluster NodePort range, 30000-32767.
ZT_BFB_REGISTRY_PORT=30806
# NVIDIA's Zero Trust documentation caps this at 1500, independent of
# NODES_MTU (the 9000 high-speed/data-plane MTU). Do not raise this above
# 1500.
ZT_CONTROL_PLANE_MTU=1500
# DPU1_SERIAL is required in Zero Trust mode; serials must be lowercase.
# Add DPU2_SERIAL, DPU3_SERIAL, ... for additional DPUs.
# To read a DPU's serial number in lowercase:
#   curl -k -u root:'BMC root password' https://<DPU_BMC_IP>/redfish/v1/Systems/Bluefield \
#     | jq -r '.SerialNumber | ascii_downcase'
DPU1_SERIAL=
# Static discovery mode only; pairs with the serial of the same number.
DPU1_BMC_IP=

# Zero Trust HBN chart and addressing. Defaults match a single tested bundle;
# override only if you know the HBN chart/image versions you need.
HBN_HELM_REPO_URL=https://helm.ngc.nvidia.com/nvidia/doca
HBN_HELM_CHART_VERSION=3.4.0
HBN_IMAGE_REPO=nvcr.io/nvidia/doca/doca_hbn
HBN_IMAGE_TAG=3.4.0-doca3.4.0
ZT_HBN_POOL1_CIDR=10.0.121.0/24
ZT_HBN_POOL2_CIDR=10.0.122.0/24
ZT_HBN_LOOPBACK_CIDR=11.44.0.0/24

# Some DPU firmware/NVConfig changes can only take effect after a full
# external power cycle of the chassis, not just a DPU/ARM reboot. When that
# happens, the DPU sits in the Rebooting phase and its DPUNode is annotated
# provisioning.dpu.nvidia.com/dpunode-external-reboot-required=true.
# false (default): make install prints manual instructions (power-cycle the
#   chassis yourself, then `make external-reboot` or the printed oc annotate
#   command) and moves on without waiting.
# true: make install power-cycles every configured chassis (the same
#   WORKER_COUNT/BMC_* used to power them on) and clears the annotation
#   itself, waiting up to WAIT_EXTERNAL_REBOOT seconds for a DPUNode to need
#   it. This power-cycles real hardware unattended; only enable it once
#   you're comfortable with that for every configured chassis.
ZT_AUTO_POWER_CYCLE=false

# Timeouts. WAIT_* values are seconds. HELM_TIMEOUT is a Helm duration.
HELM_TIMEOUT=15m
WAIT_SHORT=180
WAIT_MEDIUM=600
WAIT_CONDITIONS=1200
WAIT_HOSTED=1800
# Zero Trust only; see ZT_AUTO_POWER_CYCLE above.
WAIT_EXTERNAL_REBOOT=1800
WORKER_JOIN_TIMEOUT=3600
DPU_READY_TIMEOUT=3600
APPLY_RETRIES=12
